# Copy this file to .env and change the values. .env is gitignored.

# Postgres container credentials (used by docker-compose.yml)
POSTGRES_USER=tasks
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tasks

# Host port for the API (change it if 3000 is already taken on your machine)
APP_PORT=3000

# Connection string for running the app or Prisma CLI on your host machine
# (npm run dev, npx prisma migrate dev). Inside docker compose the app gets
# its own DATABASE_URL pointing at the "db" service instead of localhost.
DATABASE_URL=postgresql://tasks:change-me@localhost:5432/tasks?schema=public

# Redis connection string for running the app on your host machine.
# Inside docker compose the app gets REDIS_URL=redis://redis:6379 instead.
REDIS_URL=redis://localhost:6379
